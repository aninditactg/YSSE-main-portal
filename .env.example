# MySQL connection (XAMPP defaults: host 127.0.0.1, port 3306, user root, blank password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ysse_portal
DB_USER=root
DB_PASSWORD=

# Change these before creating your local admin user.
ADMIN_EMAIL=admin@ysse.local
ADMIN_PASSWORD=Change-This-Local-Password-Now-123!
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173
